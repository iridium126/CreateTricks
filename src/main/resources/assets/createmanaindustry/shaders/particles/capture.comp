// End-of-frame capture: record this frame's UNculled translucent census (keygen
// counts every live ALPHA/MODEL particle before the frustum test) into the
// counter ring slot's spare. The next frame reads it back as the lagged
// translucent count for dual-mode selection and radix dispatch sizing --
// deliberately unculled so a camera swing that reveals hidden translucent
// particles can never undersize the sort dispatch.
//
// Also publishes this generation's exact MODEL item count into the reserved
// METADATA tail slot of the sort buffer the engine binds for us (slot index ==
// capacity, see ParticleBuffers allocation). The shader-pack merge derives its
// reversed near-first cutout iteration order from that count; storing it IN the
// permutation buffer makes N and the items structurally same-generation -- an
// aborted frame leaves them stale together instead of pairing a fresh count
// with a stale permutation. The engine always binds a valid sort buffer here
// (the committed one when a sort ran, scratch otherwise), so the store below is
// never to an unbound target.
layout(local_size_x = 1) in;

layout(std430, binding = BIND_INDIRECT) readonly buffer IndirectBuf { uint cmd[INDIRECT_UINTS]; } indirect;
layout(std430, binding = BIND_SORT_WRITE) buffer SortMeta { uvec2 kv[]; } sortOut;
layout(std430, binding = BIND_COUNTER) buffer CounterBuf { uint writeSlot; uint spare; uint translucentCensus; } counter;
layout(std430, binding = BIND_POOL_WRITE) readonly buffer Pool { vec4 data[]; } pool;
layout(std430, binding = BIND_HIT) buffer HitBuf { uvec2 pair; } hitOut;

uniform int uMetaSlot; // == particle capacity: the reserved tail slot index

void main() {
    counter.spare = counter.translucentCensus;
    sortOut.kv[uMetaSlot] = uvec2(indirect.cmd[IDX_CNT_MODELOP], 0u);

    // Publish the crosshair hit-query winner's current HP beside its key (see
    // hit.comp) so the CPU can pick hurt vs death sounds when it consumes the
    // snapshot. Same buffer, same generation, readable under this frame's
    // fence -- no extra dispatch or sync.
    uvec2 h = hitOut.pair;
    if (h.x != 0xFFFFFFFFu) {
        uint idx = h.x & 0x3FFFFFu;
        hitOut.pair.y = floatBitsToUint(pool.data[idx * 4u + 3u].y);
    }
}
