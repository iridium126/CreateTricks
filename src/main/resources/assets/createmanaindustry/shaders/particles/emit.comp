// Particle emission: consumes CPU-written spawn commands and initialises new
// particles into the compacted write buffer. Deterministic per-particle hash.
// Spawn styles (emitter header 17.y):
//   0  default: position/velocity from the emitter shape + speed range
//   1  tracking crit star: origin = the referenced allay particle's chest box
//      (rejection-sampled like TrackingEmitter), vel = (d, d1+0.2, d2)·8 b/s
//      = the vanilla (d, d1+0.2, d2)·0.4 blocks/tick
//   2  damage-indicator heart: gaussian ±0.1 offset at the allay's mid-height,
//      vel = (g·1.6, g·1.6+8, g·1.6) b/s = packet speed 0.2·g + 1.0 up, all
//      ×0.4 (CritParticle) ×20 (tick→second)
//   3  storm member (server-synced Allay Storm): the command's c.y carries
//      the MEMBER INDEX BASE; memberIdx = base + inner derives a
//      deterministic seed hash(stormSeed, memberIdx) (identical on every
//      client). Two birth modes, split by the command's c.w flag:
//        analytic (c.w = 0): members present at ACTIVATE spawn exactly on
//          their circulating spiral-arm home point at the current shared-
//          clock phase with matching velocity (the SAME cmiTyphoonHome
//          function the update servo targets with), so a late-joining
//          client starts in lock-step with everyone else.
//        ring (c.w = 1): GROWTH members (center-packet deltas) spawn on a
//          horizontal ring at 120 + storm radius around the chased center —
//          outside the default visible envelope — and FLY to their home
//          point at the speed cap; the servo takes over on arrival.
//      Identity rides p0.w as memberIdx+1 (the storm size path uses a
//      constant 1.0 multiplier — see keygen/model.vsh/hit.comp).
// Combat styles 1/2 carry the spawn-time packed light (command word c.x =
// blockLight + 16·skyLight) in p2.w; textured.vsh turns it into a real
// lightmap sample when the emitter's lightMode is set.
layout(local_size_x = 64) in;

// Flat command view, 12 floats per entry (EMIT_ENTRY_FLOATS):
//   a: origin.xyz, count              (offsets 0..3)
//   b: emitterId, seed, prefixOffset (exclusive), originRef (offsets 4..7)
//   c: lightPacked, memberIdxBase (storm style 3), memberKey (combat styles:
//      memberIdx+1 -> identity-map source resolution, 0 = legacy originRef),
//      0 (offsets 8..11)
layout(std430, binding = BIND_POOL_WRITE) buffer ParticleWrite { vec4 data[]; } writeBuf;
// Read pool: combat styles resolve originRef against the committed pool.
layout(std430, binding = BIND_POOL_READ) readonly buffer ParticleRead { vec4 data[]; } readBuf;
layout(std430, binding = BIND_COUNTER) buffer CounterBuf { uint writeSlot; uint spare; uint translucentCensus; } counter;
layout(std430, binding = BIND_EMITCMD) readonly buffer EmitCmdBuf { float entries[]; } emitCmd;
layout(std430, binding = BIND_EMITTER) readonly buffer EmitterBuf { vec4 u[]; } emitters;
// Storm member identity -> pool-slot map (write side: update.comp, THIS same
// dispatch). Combat styles resolve member-keyed origins through it: command
// word c.z carries memberIdx+1 (0 = legacy pool-index addressing), so a hit's
// origin tracking survives pool recompaction across frames.
layout(std430, binding = BIND_MEMBERMAP) readonly buffer MemberMapBuf { float m[]; } memberMap;

uniform uint uTotalSpawn;
uniform uint uEmitCount;
uniform uint uCapacity;
// storm style 3: the RAW 24-bit instance seed (integer-valued float, NOT
// normalized to [0,1)), the signed angular velocity, and the CPU-side
// growth-law phase integrals
uniform float uStormSeed;
uniform float uStormOmegaNow; // SIGNED spin rate omega = SPIN_K/R_now (vortex; 0 = n/a)
uniform float uStormRotPhase;  // rotation phase (radians) — CPU growth-law integral
uniform float uStormConvPhase; // shared conveyor phase scalar (per-member scale rate/a)
uniform float uStormConvRate;  // d(convPhase)/dt — drives the target-velocity conveyor term

// the analytic spawn needs the storm chunk only (cmiTyphoonHome) — no pose math
#pragma cmi_include chunks/allay_storm.glsl

float hash1(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

vec3 randomDir(float s) {
    float a = hash1(s + 21.1) * 6.2831853;
    float c = hash1(s + 22.1) * 2.0 - 1.0;
    float r = sqrt(max(0.0, 1.0 - c * c));
    return vec3(cos(a) * r, c, sin(a) * r);
}

// Standard Box-Muller pair from two unit hashes (the combat styles reproduce
// the vanilla ClientboundLevelParticlesPacket gaussian distribution).
vec2 gaussian2(float s) {
    float u1 = max(hash1(s), 1e-6);
    float u2 = hash1(s + 17.17);
    float r = sqrt(-2.0 * log(u1));
    return vec2(r * cos(6.2831853 * u2), r * sin(6.2831853 * u2));
}

// CritParticle's base-random velocity, layered UNDER the spawner's ×0.4
// pass-through: the 7-arg Particle ctor draws a uniform cube, normalizes it
// (vanilla's own corner-clustered direction), scales to (r+r+1)·0.15·0.4
// b/tick and adds +0.1 up; CritParticle then scales that whole base ×0.1.
// Final = direction·(r+r+1)·0.04 + 0.01 up (b/tick) — returned in b/s.
// Seed slots 61.1..65.1 stay clear of both styles' existing ranges
// (style 1 ≤ ~26.2; style 2 consumes {31.7, 48.87, 41.3, 58.47, 83.1, 100.27}).
vec3 critBaseJitter(float seed) {
    vec3 cu = vec3(hash1(seed + 61.1), hash1(seed + 62.1), hash1(seed + 63.1)) * 2.0 - 1.0;
    vec3 n = cu / max(length(cu), 1e-5);
    float mag = (hash1(seed + 64.1) + hash1(seed + 65.1) + 1.0) * 0.15 * 0.04;
    return (n * mag + vec3(0.0, 0.01, 0.0)) * 20.0;
}

// Wide-magnitude per-particle hash seed. The CPU base seed spans [0,1)
// (1e-6 steps, plus inner·1e-4) where hash1's fract(p*0.1031) never folds —
// every hash of it varies SMOOTHLY with inner, so multi-particle commands
// arrange their particles along a spiral/clump instead of a uniform volume.
// Scaling base ×1e5 + inner·307 lands in [0, ~7e5] → ~72k folds. One
// FMA-able expression: cross-client bit-equality is a storm-identity
// requirement ONLY (the storm branch builds its own mseed and never reads
// this) — every other path takes the contracted form.
float wideSeed(float seed, float inner) {
    return seed * 100000.0 + float(inner) * 307.0;
}

// Source allay metrics for the combat styles: bbWidth/bbHeight from the
// referenced particle's emitter header (corpse/alive life clamps to 1, so
// sizeEnd is the operative size — same formula as hit.comp).
void sourceMetrics(uint srcIdx, out vec3 feet, out float width, out float height) {
    uint sb = srcIdx * VEC4_PER_PARTICLE;
    vec4 sp0 = readBuf.data[sb + 0u];
    vec4 sp3 = readBuf.data[sb + 3u];
    uint seid = floatBitsToUint(sp3.w);
    uint shb = seid * VEC4_PER_EMITTER;
    // storm members carry their IDENTITY in p0.w (memberIdx+1) — the size
    // multiplier is the constant 1.0 then (header storm slot 18.x), same
    // guard as hit.comp/model.vsh/update.comp's death chain; without it the
    // combat spawn offsets scale with the member index
    float pmul = emitters.u[shb + 18u].x > 0.5 ? 1.0 : sp0.w;
    float ssize = emitters.u[shb + 5u].w * pmul;
    float sscale = (2.0 * ssize) / MODEL_ABOVE_FEET;
    feet = sp0.xyz;
    width = 0.35 * sscale;  // vanilla Allay bbWidth × render scale
    height = 0.6 * sscale;  // vanilla Allay bbHeight × render scale
}

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= uTotalSpawn)
        return;

    // Locate our command by binary search over the CPU-written exclusive
    // prefix offsets (prefix[e] <= g < prefix[e] + count[e]). O(log N) per
    // thread instead of a linear scan over all entries.
    uint lo = 0u;
    uint hi = uEmitCount;
    while (lo + 1u < hi) {
        uint mid = (lo + hi) >> 1u;
        if (uint(emitCmd.entries[mid * 12u + 6u]) <= g)
            lo = mid;
        else
            hi = mid;
    }
    uint eb = lo * 12u;
    float count = emitCmd.entries[eb + 3u];
    uint inner = g - uint(emitCmd.entries[eb + 6u]);
    if (inner >= uint(count))
        return; // defensive: g past the last entry's count

    uint eid = uint(emitCmd.entries[eb + 4u]);
    // wide per-particle hash seed (see wideSeed) — the stored p3.z carries the
    // wide value too, so update/render hash consumers decorrelate within
    // multi-particle commands as well
    float seed = wideSeed(emitCmd.entries[eb + 5u] + float(inner) * 0.0001, inner);
    float originRef = emitCmd.entries[eb + 7u]; // 0 = absolute origin.xyz, else particle index + 1
    float lightPacked = emitCmd.entries[eb + 8u]; // blockLight + 16*skyLight (combat styles + lightmap specs)
    float spawnStyle = emitters.u[eid * VEC4_PER_EMITTER + 17u].y;

    vec3 pos;
    vec3 velDir;
    // Vanilla particles spawn at billboard roll 0 (cherry petals start
    // upright; the per-particle spin then diverges them — textured.vsh). The
    // old ±π roll jitter is gone with the cherry alignment.
    float lightOut = 0.0;
    // style 3 ONLY — the gate must not swallow the later style-4 (hex spray)
    // branch (a hex command's c slots are spray params, not storm fields, and
    // its header carries no storm anchor: caught here it spawned every mote at
    // the zero anchor instead of the spray origin)
    if (spawnStyle > 2.5 && spawnStyle < 3.5) {
        // ---- storm member: deterministic identity + analytic spawn -------
        uint memberIdx = uint(emitCmd.entries[eb + 9u] + 0.5) + inner;
        uint hbS = eid * VEC4_PER_EMITTER;
        vec4 stormA = emitters.u[hbS + 18u];
        vec3 anchor = emitters.u[hbS + 19u].xyz;
        // seed = hash(stormSeed, memberIdx). Two discipline rules, learned the
        // hard way:
        //  1. NO a*b+c anywhere below — an a*b+c may legally contract into an
        //     FMA with driver-dependent rounding, and one ULP at this
        //     magnitude (~8e4 -> ULP 0.0078) avalanches into a different
        //     identity per GPU vendor. Every statement is a single mul/add.
        //  2. The seed must enter the hash at a WIDE magnitude: cmiHash1's
        //     step-1 fract(p*0.1031) only folds when p spans >= ~10, and its
        //     output carries just ~13.7k effective buckets — a [0,1)-scale
        //     input and/or a single pass cannot separate 131072 members. The
        //     old mi + uStormSeed*17.17 did BOTH wrong: the product reached
        //     ~2.9e8 where a float's ULP is 32, so the addition swallowed mi
        //     entirely for ~94% of seeds — every member derived the SAME
        //     identity, spawned stacked at one spot, and the d^2 > 1e-8
        //     separation guard then locked the clump permanently.
        float s0 = cmiHash1(uStormSeed + 31.7);  // [0,1), one value per storm
        float shift = s0 * 97.0;
        float t = float(memberIdx) * 0.6123;
        float p = t + 0.7;
        float q = p + shift;                     // spans ~[0.7, 80360] -> ~8285 folds
        float hA = cmiHash1(q);
        float q2 = q * 7.31;                     // second pass, decorrelated input
        float hB = cmiHash1(q2);
        float mA = hA * 0.618;
        float mB = hB * 0.382;
        float mseed = mA + mB;                   // [0,1); 2048 members: exact, 131072: ~95% distinct
        float stormR = max(stormA.y, 2.0);
        float spMax = max(stormA.w, 0.5);
        // Home point: cmiTyphoonHome is the SAME function update.comp's
        // servo targets with (single source in chunks/allay_pose.glsl) —
        // the spawn state IS the servo's equilibrium, so late joiners
        // start settled with no transient. The center is the server-chased
        // anchor; there is no per-member wander.
        vec3 home;
        vec3 homeVel;
        cmiTyphoonHome(mseed, stormR, uStormOmegaNow, uStormRotPhase,
                uStormConvPhase, uStormConvRate, spMax, anchor, home, homeVel);
        vec3 spos;
        vec3 svel;
        // c.w = ring-spawn flag: GROWTH members (center-packet deltas) are
        // born on the ring and fly in; ACTIVATE-sourced members spawn settled.
        if (emitCmd.entries[eb + 11u] > 0.5) {
            // ---- growth member: ring birth outside the visible envelope ----
            // Radius = SPAWN_RING_BLOCKS + the CURRENT storm radius. The 120
            // is a server constant mirroring the DEFAULT client visibility
            // envelope (fade 96 + 24 ramp = the model path's hard-cull bound):
            // the fade is a client config the server cannot read, so the ring
            // is a deterministic function of synced state (120 + header
            // radius) rather than per-client — identical births on every
            // client/GPU. Angle = memberIdx * golden angle (2.399963 rad):
            // consecutive growth members rotate around the circle, a perfectly
            // uniform birth distribution with no hash-quality risk. Velocity
            // points at the member's OWN home point at the speed cap; the
            // servo takes over from there. The ring is HORIZONTAL at the
            // storm's altitude (anchor.y).
            float ringA = float(memberIdx) * 2.399963;
            float ringR = 120.0 + stormR;
            spos = anchor + vec3(cos(ringA) * ringR, 0.0, sin(ringA) * ringR);
            vec3 toHome = home - spos;
            float dHome = length(toHome);
            svel = dHome > 1e-3 ? toHome * (spMax / dHome) : vec3(0.0);
        } else {
            // analytic: ON the home point at the spawn instant — settled.
            spos = home;
            svel = homeVel;
        }
        uint slot = atomicAdd(counter.writeSlot, 1u);
        if (slot >= uCapacity)
            return;
        uint wb = slot * 4u;
        // p0.w = memberIdx+1: storm identity (0 impossible, disambiguated
        // from non-storm size multipliers by the header's storm mode slot)
        writeBuf.data[wb + 0u] = vec4(spos, float(memberIdx + 1u));
        writeBuf.data[wb + 1u] = vec4(svel, 0.0);
        writeBuf.data[wb + 2u] = vec4(1.0, 1.0, 1.0, 0.0); // p2.w: hurt timer
        writeBuf.data[wb + 3u] = vec4(0.0, 20.0, mseed, uintBitsToFloat(eid));
        return;
    }
    if (spawnStyle > 3.5) {
        // ---- hex spray (style 4): Hexcasting ParticleSpray replication -----
        // MsgCastParticleS2C.Handler's exact sampling. Spawn position = the
        // spray origin + a uniform-sphere offset of radius u·fuzziness/2 —
        // the radius is LINEAR in u, vanilla's own quirk (not sqrt-scaled).
        // Velocity = velUnlen·|vel| where velUnlen is drawn around the spray
        // axis with the acos-uniform cone trick (phi = acos(1 - u·(1-cos
        // spread)) samples the cone uniformly by solid angle). Motion/roll/
        // life/size replicate ConjureParticle (see HexSpecs).
        // Command c slots (this style uses NO light/member/ring fields):
        //   c.xyz = spray velocity, blocks/s
        //   c.w   = intBitsToFloat(fuzz16 | spread16 << 16), fuzz/2 and
        //           spread/π each quantized to 16 bits
        vec3 sprayVel = vec3(emitCmd.entries[eb + 8u], emitCmd.entries[eb + 9u],
                emitCmd.entries[eb + 10u]);
        uint packedP = floatBitsToUint(emitCmd.entries[eb + 11u]);
        float fuzz = float(packedP & 0xFFFFu) / 65535.0 * 2.0;
        float spread = float((packedP >> 16u) & 0xFFFFu) / 65535.0 * 3.14159265;
        // hex commands are always absolute-origin (originRef 0); the classic
        // path's `origin` local is declared further down, so read the command
        // word here
        // `seed` is already the wide per-particle value (wideSeed at the top
        // of main) — every hash below decorrelates across inner
        vec3 origin = vec3(emitCmd.entries[eb + 0u], emitCmd.entries[eb + 1u],
                emitCmd.entries[eb + 2u]);
        pos = origin + randomDir(seed) * (hash1(seed + 71.1) * fuzz * 0.5);
        vec3 axis = sprayVel / max(length(sprayVel), 1e-5);
        float cs = clamp(1.0 - hash1(seed + 72.1) * (1.0 - cos(spread)), -1.0, 1.0);
        float phi = acos(cs);
        float theta = 6.2831853 * hash1(seed + 73.1);
        vec3 k = cross(axis, vec3(0.0, 0.0, 1.0));
        // vanilla guards the axis ∥ +Z case by swapping to (1,0,0)
        if (dot(k, k) < 1e-6)
            k = vec3(1.0, 0.0, 0.0);
        k = normalize(k);
        vec3 k2 = cross(axis, k);
        float sp = sin(phi);
        vec3 velUnlen = axis * cs + k * (sp * cos(theta)) + k2 * (sp * sin(theta));
        vec3 vel = velUnlen * length(sprayVel); // blocks/s (spray vel is b/s)
        float roll = hash1(seed + 74.1) * 6.2831853; // ConjureParticle: fixed random roll
        // lifetime 64/((r+3)·0.25) ticks, continuous (no integer-tick cast)
        float maxLife = max(64.0 / ((hash1(seed + 75.1) + 3.0) * 0.25), 0.1) / 20.0;
        // quadSize = SingleQuadParticle default [0.1, 0.2) × 0.9 = [0.09, 0.18)
        // — the 0.135 spec base × this exact [2/3, 4/3] hash range
        float baseSize = mix(2.0 / 3.0, 4.0 / 3.0, hash1(seed + 13.1));
        uint slot = atomicAdd(counter.writeSlot, 1u);
        if (slot >= uCapacity)
            return;
        uint wb = slot * 4u;
        writeBuf.data[wb + 0u] = vec4(pos, baseSize);
        writeBuf.data[wb + 1u] = vec4(vel, roll);
        writeBuf.data[wb + 2u] = vec4(1.0, 1.0, 1.0, 1.0);
        writeBuf.data[wb + 3u] = vec4(0.0, maxLife, seed, uintBitsToFloat(eid));
        return;
    }
    if (spawnStyle > 0.5) {
        // ---- combat styles: origin resolves against the committed pool ----
        // c.z = memberIdx+1 selects MEMBER addressing through the identity
        // map (rebuilt by update.comp this same dispatch, so the resolved
        // slot always matches the read pool being spawned into): immune to
        // recompaction between the hit snapshot and multi-frame tracking
        // rides, and to stale snapshots under GPU fence lag. 0 = the legacy
        // pool-index path (non-storm MODEL debug particles). An absent entry
        // (member not in this generation's pool: not yet spawned, LRU-evicted
        // or identity beyond capacity) DROPS the spawn instead of resolving
        // onto whatever now occupies a stale slot.
        uint srcIdx;
        float memberKey = emitCmd.entries[eb + 10u];
        if (memberKey > 0.5) {
            uint mi = uint(memberKey) - 1u;
            if (mi >= uCapacity)
                return;
            uint slot = floatBitsToUint(memberMap.m[mi]);
            if (slot == 0u)
                return;
            srcIdx = slot - 1u;
        } else {
            if (originRef < 1.0)
                return; // malformed combat command: drop, never fall to classic
            srcIdx = uint(originRef) - 1u;
        }
        vec3 feet;
        float sw, sh;
        sourceMetrics(srcIdx, feet, sw, sh);
        lightOut = lightPacked;
        if (spawnStyle < 1.5) {
            // tracking crit star: TrackingEmitter's rejection-sampled unit cube
            // point (d² <= 1), positioned at entity.getX(d0/4) / getY(0.5+d1/4)
            vec3 d = vec3(0.0, 0.2, 0.0);
            for (int k = 0; k < 8; k++) {
                vec3 c = vec3(hash1(seed + float(k) * 3.31 + 1.0),
                              hash1(seed + float(k) * 3.31 + 2.0),
                              hash1(seed + float(k) * 3.31 + 3.0)) * 2.0 - 1.0;
                if (dot(c, c) <= 1.0) {
                    d = c;
                    break;
                }
            }
            pos = vec3(feet.x + sw * (d.x / 4.0),
                       feet.y + sh * (0.5 + d.y / 4.0),
                       feet.z + sw * (d.z / 4.0));
            velDir = vec3(d.x, d.y + 0.2, d.z); // vel = dir * 0.4 b/tick = dir * 8 b/s
            float speed = 8.0;
            vec3 vel = velDir * speed + critBaseJitter(seed);
            // CritParticle quadSize = SingleQuadParticle default [0.1, 0.2)
            // × 0.75 = [0.075, 0.15) — the 0.1125 spec base × this exact
            // [2/3, 4/3] hash range (the old 0.7..1.3 narrowed both ends ~5%)
            float baseSize = mix(2.0 / 3.0, 4.0 / 3.0, hash1(seed + 13.1));
            float maxLife = max(mix(emitters.u[eid * VEC4_PER_EMITTER + 5u].x,
                                    emitters.u[eid * VEC4_PER_EMITTER + 5u].y,
                                    hash1(seed + 12.1)), 0.1);
            uint slot = atomicAdd(counter.writeSlot, 1u);
            if (slot >= uCapacity)
                return;
            uint wb = slot * 4u;
            writeBuf.data[wb + 0u] = vec4(pos, baseSize);
            writeBuf.data[wb + 1u] = vec4(vel, 0.0);
            writeBuf.data[wb + 2u] = vec4(1.0, 1.0, 1.0, lightOut);
            writeBuf.data[wb + 3u] = vec4(0.0, maxLife, seed, uintBitsToFloat(eid));
            return;
        } else {
            // damage-indicator heart: packet offsets gaussian·0.1 (x/z) at the
            // allay's mid-height; speed gaussian·0.2 + the provider's +1.0 up,
            // all through CritParticle's ×0.4 → b/s (×0.4·20 = ×8)
            float h6 = seed + 31.7;
            vec2 g1 = gaussian2(h6);
            vec2 g2 = gaussian2(h6 + 41.3);
            vec2 g3 = gaussian2(h6 + 83.1);
            pos = vec3(feet.x + g1.x * 0.1,
                       feet.y + sh * 0.5,
                       feet.z + g1.y * 0.1);
            vec3 vel = vec3(g2.x * 0.2, g2.y * 0.2 + 1.0, g3.x * 0.2) * 8.0
                    + critBaseJitter(seed);
            float baseSize = mix(2.0 / 3.0, 4.0 / 3.0, hash1(seed + 13.1));
            float maxLife = max(mix(emitters.u[eid * VEC4_PER_EMITTER + 5u].x,
                                    emitters.u[eid * VEC4_PER_EMITTER + 5u].y,
                                    hash1(seed + 12.1)), 0.1);
            uint slot = atomicAdd(counter.writeSlot, 1u);
            if (slot >= uCapacity)
                return;
            uint wb = slot * 4u;
            writeBuf.data[wb + 0u] = vec4(pos, baseSize);
            writeBuf.data[wb + 1u] = vec4(vel, 0.0);
            writeBuf.data[wb + 2u] = vec4(1.0, 1.0, 1.0, lightOut);
            writeBuf.data[wb + 3u] = vec4(0.0, maxLife, seed, uintBitsToFloat(eid));
            return;
        }
    }

    // ---- classic style-0 path (shape-based) ----
    uint hb = eid * VEC4_PER_EMITTER;
    float shape = emitters.u[hb + 1u].x;
    float speedMin = emitters.u[hb + 1u].y;
    float speedMax = emitters.u[hb + 1u].z;
    float size = emitters.u[hb + 0u].w;
    float lifeMin = emitters.u[hb + 5u].x;
    float lifeMax = emitters.u[hb + 5u].y;
    float tanHalf = emitters.u[hb + 6u].y;
    vec3 origin = vec3(emitCmd.entries[eb + 0u], emitCmd.entries[eb + 1u], emitCmd.entries[eb + 2u]);

    float speed = mix(speedMin, speedMax, hash1(seed + 11.31));
    if (shape < 0.5) {                     // POINT
        pos = origin;
        velDir = randomDir(seed);
    } else if (shape < 1.5) {              // BOX (cube of half-extent `size`)
        vec3 uvw = vec3(hash1(seed + 1.0), hash1(seed + 2.0), hash1(seed + 3.0));
        pos = origin + (uvw - 0.5) * 2.0 * size;
        velDir = randomDir(seed + 4.0);
    } else if (shape < 2.5) {              // SPHERE (radius `size`)
        vec3 d = randomDir(seed + 5.0);
        pos = origin + d * (size * pow(hash1(seed + 6.0), 1.0 / 3.0));
        velDir = d;
    } else {                               // CONE (height `size`, axis = windDir)
        vec3 axis = normalize(emitters.u[hb + 4u].xyz);
        // Build a tangent frame; guard the axis || +Y case BEFORE normalizing
        // (normalize of a zero cross product is NaN and would poison the spawn).
        vec3 side = cross(axis, vec3(0.0, 1.0, 0.0));
        if (dot(side, side) < 1e-6)
            side = cross(axis, vec3(1.0, 0.0, 0.0));
        vec3 t1 = normalize(side);
        vec3 t2 = cross(axis, t1);
        float hgt = size * hash1(seed + 7.0);
        float ang = 6.2831853 * hash1(seed + 8.0);
        float rad = tanHalf * hgt * sqrt(hash1(seed + 9.0));
        pos = origin + axis * hgt + (t1 * cos(ang) + t2 * sin(ang)) * rad;
        float spread = mix(0.0, tanHalf, hash1(seed + 10.0));
        vec3 sdir = normalize(axis + (t1 * cos(ang) + t2 * sin(ang)) * spread);
        velDir = sdir;
    }

    vec3 vel = velDir * speed;
    float spawnMatId = emitters.u[hb + 7u].x;
    bool isModel = spawnMatId >= 1.5 && spawnMatId < 2.5;
    // MODEL particles are vanilla allays: the maxLife slot carries HIT POINTS
    // (Allay.createAttributes MAX_HEALTH = 20.0) instead of a lifetime -- they
    // are immortal and die only when the HP reaches zero. Every other material
    // keeps the header lifetime; the protective floor stays (a zero/garbage
    // lifetime header must never kill a particle the frame it spawns).
    float maxLife = isModel
            ? 20.0
            : max(mix(lifeMin, lifeMax, hash1(seed + 12.1)), 0.1);
    // Per-particle size. MODEL particles stand in for a vanilla ENTITY --
    // vanilla allays are uniform, so they render at the exact spec scale
    // (material check mirrors keygen). The only classic-path size variance
    // left is vanilla CherryParticle's 50/50 quadSize pick of 0.05 / 0.075 --
    // a spec base of 0.075 x {1.0, 2/3} -- keyed on flutter > 0 (the cherry
    // spec is the only flutter user); every other classic preset renders at
    // the exact spec scale (the old +/-30% jitter is gone with the cherry
    // alignment).
    float baseSize = 1.0;
    if (!isModel && emitters.u[hb + 7u].z > 0.0 && hash1(seed + 13.1) < 0.5)
        baseSize = 2.0 / 3.0;
    // MODEL: p2.w is the per-particle HURT-FLASH timer (0 = not hurt), decayed
    // by update.comp; the model path never reads intensity, and the additive
    // path never sees MODEL particles. Textured non-MODEL: p2.w carries the
    // spawn-time packed light when the spec opts into the lightmap (vanilla
    // cherry leaves; header 17.z, the material-split slot -- the CPU samples
    // it per emit command into lightPacked, word c.x) or 1.0 fullbright
    // (vanilla particles spawn at alpha 1).
    float spawnLight = isModel ? 0.0
            : (emitters.u[hb + 17u].z > 0.5 ? max(lightPacked, 0.0) : 1.0);

    uint slot = atomicAdd(counter.writeSlot, 1u);
    if (slot >= uCapacity)
        return;

    uint wb = slot * 4u;
    writeBuf.data[wb + 0u] = vec4(pos, baseSize);
    writeBuf.data[wb + 1u] = vec4(vel, 0.0);
    writeBuf.data[wb + 2u] = vec4(1.0, 1.0, 1.0, spawnLight);
    writeBuf.data[wb + 3u] = vec4(0.0, maxLife, seed, uintBitsToFloat(eid));
}
