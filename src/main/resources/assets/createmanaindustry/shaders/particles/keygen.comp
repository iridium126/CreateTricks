// Partition pass for the draw permutations -- runs EVERY frame (it is also the
// fast path's cull pass). Three buckets:
//   - ADDITIVE particles    -> orderAdd[]   (dense uint permutation, unsorted)
//   - OPAQUE cutout sprites -> orderOpaque[](dense uint permutation, unsorted)
//   - translucent particles -> sortData[]   one item EACH: MODEL particles
//                             (sort-type 0) and ALPHA sprites (sort-type 1)
// Every particle first passes a GPU frustum test (sphere vs 6 normalized
// planes extracted on the CPU from Proj*View), so off-screen particles never
// reach vertex shading. The GPU counts live in the flat indirect array
// (field j of command i = cmd[5*i+j]); keygen owns them exclusively.
//
// Translucent sorting (user-visible correctness): ALPHA sprites and the MODEL
// translucent parts (cloak + wings) go through ONE counting sort per frame.
// The 9-bit sort key carries the TYPE IN ITS HIGH BIT (SORT_KEY_TYPE_SHIFT):
//   key = (sortType << SORT_KEY_TYPE_SHIFT) | invertedDepthBand
// so the scatter partitions the sorted array by type -- MODEL items occupy
// [0, N_model), ALPHA items [N_model, N_total). Each draw therefore gets an
// EXACT instanceCount and reads only its own contiguous slice:
//   cmd2/cmd3 instanceCount = IDX_CNT_MODELOP / IDX_CNT_XLU = N_model
//     (model.vsh reads sortedKv[gl_InstanceID])
//   cmd4  instanceCount     = IDX_CNT_ALPHA        = N_alpha
//     (textured.vsh mode 0 reads sortedKv[N_model + gl_InstanceID]; the
//     partition start IS the model count, taken from the indirect SSBO)
// No vertex invocations are launched for foreign-type items anymore.
// Item payload still = (particleIndex << 2) | sortType; the in-shader type
// filters remain as pure defense against corruption (they can never fire on
// a healthy partition).
// Initial compaction uses counter.sortItems (a plain append cursor -- the
// radix scatter determines final placement), NOT the per-type draw counts.
//
// Depth key: logarithmically quantized 8-bit bands over [1, uMaxDepth] blocks,
// giving ~constant RELATIVE depth resolution (~2% per band). FAR bands get
// the SMALL key, so the ascending counting sort orders far items first --
// back-to-front compositing within each type partition. Within one band the
// order is arbitrary; because the two translucent draws render type-batched
// (all model items, then all sprite items), cross-type compositing is decided
// by the draw sequence alone and stays deterministic regardless of intra-band
// arrival order.
layout(local_size_x = 64) in;

layout(std430, binding = BIND_POOL_READ) readonly buffer ParticleRead { vec4 data[]; } pool;
layout(std430, binding = BIND_INDIRECT) buffer IndirectBuf { uint cmd[INDIRECT_UINTS]; } indirect;
// 4th word sortItems = translucent-item append cursor for THIS frame's initial
// sort array (the other compute passes declare only the first three members;
// offsets of those are unchanged by appending a 4th).
layout(std430, binding = BIND_COUNTER) buffer CounterBuf { uint writeSlot; uint spare; uint translucentCensus; uint sortItems; } counter;
layout(std430, binding = BIND_EMITTER) readonly buffer EmitterBuf { vec4 u[]; } emitters;
layout(std430, binding = BIND_SORT_WRITE) buffer SortWrite { uvec2 kv[]; } sortOut;
layout(std430, binding = BIND_ORDER_ADD) buffer OrderAddW { uint order[]; } orderAdd;
layout(std430, binding = BIND_ORDER_OPAQUE) buffer OrderOpaqueW { uint order[]; } orderOpaque;

uniform uint uUpper;      // CPU-side safe upper bound (aliveRead + spawns + margin)
uniform vec3 uCamPos;
uniform mat4 uView;
uniform float uMaxDepth;  // power-of-two far bound >= fade end (Java sortFarBlocks())
uniform vec4 uFrustum[6]; // normalized planes, distances vs camera-relative points

bool sphereVisible(vec3 rel, float r) {
    for (int i = 0; i < 6; i++) {
        vec4 pl = uFrustum[i];
        if (dot(pl.xyz, rel) + pl.w < -r)
            return false;
    }
    return true;
}

uint depthKey(vec3 worldPos) {
    // view-space depth: negative z is in front of the camera
    vec4 vs = uView * vec4(worldPos - uCamPos, 1.0);
    float depth = clamp(-vs.z, BAND_NEAR, uMaxDepth);
    float t = log2(depth / BAND_NEAR) / log2(max(uMaxDepth, 2.0) / BAND_NEAR);
    uint band = min(DEPTH_BANDS - 1u, uint(t * float(DEPTH_BANDS)));
    return (DEPTH_BANDS - 1u) - band; // far -> small key -> drawn first
}

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= uUpper || g >= counter.writeSlot)
        return;

    uint base = g * VEC4_PER_PARTICLE;
    vec4 p0 = pool.data[base + 0u];
    vec4 p3 = pool.data[base + 3u];

    uint eid = floatBitsToUint(p3.w);
    uint hb = eid * VEC4_PER_EMITTER;

    // conservative bound of the billboard's half-extent (size interpolates
    // between the keyframes; p0.w is the per-particle multiplier). MODEL
    // particles are a full 3D body ~2*size tall -- use a 1.5x margin so a
    // partially-offscreen allay never pops at the screen edge.
    float matId = emitters.u[hb + 7u].x;
    float keySize = max(emitters.u[hb + 5u].z, emitters.u[hb + 5u].w) * p0.w;
    float radius = matId >= 1.5 && matId < 2.5 ? keySize * 1.5 : keySize;

    // translucent census BEFORE the cull test: every live ALPHA/MODEL particle
    // counts (off-screen included) so the dual-mode decision and the radix
    // dispatch sizing can never undersize when the camera swings
    if (matId >= 0.5 && matId < 2.5)
        atomicAdd(counter.translucentCensus, 1u);

    if (!sphereVisible(p0.xyz - uCamPos, radius))
        return;

    if (matId < 0.5) {
        // ADDITIVE: dense permutation, order irrelevant
        uint pos = atomicAdd(indirect.cmd[IDX_CNT_ADD], 1u);
        orderAdd.order[pos] = g;
    } else if (matId >= 2.5) {
        // OPAQUE cutout sprite: dense permutation, depth writes make it
        // order-independent like the MODEL opaque segment
        uint pos = atomicAdd(indirect.cmd[IDX_CNT_SPRITE], 1u);
        orderOpaque.order[pos] = g;
    } else if (matId < 1.5) {
        // ALPHA blended sprite -> sort-type 1 (upper partition). The append
        // cursor only compacts the initial array; the scatter decides final
        // placement from the key's type bit. cmd4 gets its exact count.
        uint slot = atomicAdd(counter.sortItems, 1u);
        sortOut.kv[slot] = uvec2((1u << SORT_KEY_TYPE_SHIFT) | depthKey(p0.xyz),
                                 (g << 2) | 1u);
        atomicAdd(indirect.cmd[IDX_CNT_ALPHA], 1u);
    } else {
        // MODEL -> sort-type 0 (lower partition). Both model segments cover
        // this same partition (only their element ranges differ), so both
        // count fields receive N_model; textured.vsh also reads IDX_CNT_MODELOP
        // as its partition start offset.
        uint slot = atomicAdd(counter.sortItems, 1u);
        sortOut.kv[slot] = uvec2(depthKey(p0.xyz), (g << 2) | 0u);
        atomicAdd(indirect.cmd[IDX_CNT_XLU], 1u);
        atomicAdd(indirect.cmd[IDX_CNT_MODELOP], 1u);
    }
}
