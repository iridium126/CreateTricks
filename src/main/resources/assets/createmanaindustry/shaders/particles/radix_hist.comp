// Counting-sort histogram pass over the COMBINED translucent items (ALPHA
// sprites + MODEL translucent parts; item type rides in the payload, not the
// key). The element count is the GPU-written total (indirect.cmd[16]).
layout(local_size_x = 64) in;

// 20-byte-stride indirect commands; translucent item total = cmd[5*3 + 1] = cmd[16]
layout(std430, binding = 2) buffer IndirectBuf { uint cmd[25]; } indirect;
layout(std430, binding = 6) readonly buffer SortRead { uvec2 kv[]; } sortIn;
layout(std430, binding = 9) buffer HistBuf { uint h[256]; } hist;

uniform uint uShift;

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= indirect.cmd[16])
        return;
    uint k = sortIn.kv[g].x;
    uint bin = (k >> uShift) & 255u;
    atomicAdd(hist.h[bin], 1u);
}
