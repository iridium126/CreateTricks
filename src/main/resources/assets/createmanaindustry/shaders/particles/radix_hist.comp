// Counting-sort histogram pass over ALL translucent items (MODEL parts +
// ALPHA sprites). The 9-bit key carries the type in bit SORT_KEY_TYPE_SHIFT
// and the depth band in the low byte; RADIX_BINS == 512 covers type x band,
// so the scan/scatter place each type in its own contiguous partition.
// Element count = exact per-type counts summed (cmd[GHOST] + cmd[ALPHA];
// the carrier region lives behind the radix output and is never touched).
layout(local_size_x = 64) in;

layout(std430, binding = BIND_INDIRECT) buffer IndirectBuf { uint cmd[INDIRECT_UINTS]; } indirect;
layout(std430, binding = BIND_SORT_READ) readonly buffer SortRead { uvec2 kv[]; } sortIn;
layout(std430, binding = BIND_HIST) buffer HistBuf { uint h[RADIX_BINS]; } hist;

uniform uint uShift;

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= indirect.cmd[IDX_CNT_GHOST] + indirect.cmd[IDX_CNT_ALPHA])
        return;
    uint k = sortIn.kv[g].x;
    uint bin = (k >> uShift) & (RADIX_BINS - 1u);
    atomicAdd(hist.h[bin], 1u);
}
