// Counting-sort histogram pass over the COMBINED translucent items (ALPHA
// sprites + MODEL translucent parts; the item type rides in the payload, not
// the key). The element count is the GPU-written combined total -- the SAME
// value feeds BOTH translucent draw commands (IDX_CNT_XLU / IDX_CNT_ALPHA).
layout(local_size_x = 64) in;

layout(std430, binding = BIND_INDIRECT) buffer IndirectBuf { uint cmd[INDIRECT_UINTS]; } indirect;
layout(std430, binding = BIND_SORT_READ) readonly buffer SortRead { uvec2 kv[]; } sortIn;
layout(std430, binding = BIND_HIST) buffer HistBuf { uint h[RADIX_BINS]; } hist;

uniform uint uShift;

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= indirect.cmd[IDX_CNT_XLU])
        return;
    uint k = sortIn.kv[g].x;
    uint bin = (k >> uShift) & (RADIX_BINS - 1u);
    atomicAdd(hist.h[bin], 1u);
}
