// LSD radix sort — exclusive prefix sum of the 256-bin histogram. A single
// 256-thread workgroup runs a tiny serial scan (trivial cost, once per pass).
layout(local_size_x = 256) in;

layout(std430, binding = 9) buffer HistBuf { uint h[256]; } hist;
layout(std430, binding = 10) buffer OffsBuf { uint o[256]; } offs;

shared uint s[256];

void main() {
    uint i = gl_LocalInvocationID.x;
    s[i] = hist.h[i];
    barrier();
    uint acc = 0u;
    for (uint j = 0u; j < i; j++)
        acc += s[j];
    offs.o[i] = acc;
}
