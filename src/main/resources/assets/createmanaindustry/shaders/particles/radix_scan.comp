// LSD radix sort -- exclusive prefix sum of the histogram. A single
// RADIX_BINS-thread workgroup (512 = MODEL bands 0..255 then ALPHA bands
// 0..255, so the prefix offsets already encode the type partitions) runs a
// tiny serial scan (trivial cost, once per pass).
layout(local_size_x = RADIX_BINS) in;

layout(std430, binding = BIND_HIST) buffer HistBuf { uint h[RADIX_BINS]; } hist;
layout(std430, binding = BIND_OFFSETS) buffer OffsBuf { uint o[RADIX_BINS]; } offs;

shared uint s[RADIX_BINS];

void main() {
    uint i = gl_LocalInvocationID.x;
    s[i] = hist.h[i];
    barrier();
    uint acc = 0u;
    for (uint j = 0u; j < i; j++)
        acc += s[j];
    offs.o[i] = acc;
}
