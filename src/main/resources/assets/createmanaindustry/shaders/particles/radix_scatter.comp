// Counting-sort scatter pass over the COMBINED translucent items (single
// pass; bound by the GPU combined total -- the same value that feeds both
// translucent draw commands). Within-band order is arbitrary and harmless;
// bands are ordered far->near by the inverted key. uShift stays at 0 -- the
// key is one byte wide.
layout(local_size_x = 64) in;

layout(std430, binding = BIND_INDIRECT) buffer IndirectBuf { uint cmd[INDIRECT_UINTS]; } indirect;
layout(std430, binding = BIND_SORT_READ) readonly buffer SortRead { uvec2 kv[]; } sortIn;
layout(std430, binding = BIND_SORT_WRITE) buffer SortWrite { uvec2 kv[]; } sortOut;
layout(std430, binding = BIND_OFFSETS) buffer OffsBuf { uint o[RADIX_BINS]; } offs;

uniform uint uShift;

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= indirect.cmd[IDX_CNT_XLU])
        return;
    uvec2 kv = sortIn.kv[g];
    uint bin = (kv.x >> uShift) & (RADIX_BINS - 1u);
    uint dst = atomicAdd(offs.o[bin], 1u);
    sortOut.kv[dst] = kv;
}
