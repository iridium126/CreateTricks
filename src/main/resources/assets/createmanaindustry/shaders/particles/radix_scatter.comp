// LSD radix sort — scatter pass over the ALPHA segment only (bound by the GPU
// alpha count, indirect.cmd[1].y). sortIn/sortOut are swapped each pass by CPU.
layout(local_size_x = 64) in;

layout(std430, binding = 2) buffer IndirectBuf { uvec4 cmd[2]; } indirect;
layout(std430, binding = 6) readonly buffer SortRead { uvec2 kv[]; } sortIn;
layout(std430, binding = 7) buffer SortWrite { uvec2 kv[]; } sortOut;
layout(std430, binding = 10) buffer OffsBuf { uint o[256]; } offs;

uniform uint uShift;

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= indirect.cmd[1].y)
        return;
    uvec2 kv = sortIn.kv[g];
    uint bin = (kv.x >> uShift) & 255u;
    uint dest = atomicAdd(offs.o[bin], 1u);
    sortOut.kv[dest] = kv;
}
