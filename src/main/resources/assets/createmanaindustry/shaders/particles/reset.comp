layout(local_size_x = 1) in;

layout(std430, binding = 2) buffer IndirectBuf {
    uvec4 cmd; // x = vertex count, y = instance count, z = first, w = baseInstance
} indirect;

layout(std430, binding = 3) buffer CounterBuf {
    uint writeSlot;
    uint spare;
} counter;

void main() {
    counter.writeSlot = 0u;
    counter.spare = 0u;
    indirect.cmd.y = 0u;
}
