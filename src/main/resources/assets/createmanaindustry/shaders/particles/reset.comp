layout(local_size_x = 1) in;

// INDIRECT_COMMANDS commands x INDIRECT_STRIDE bytes at a uniform stride
// (DrawElementsIndirectCommand layout; arrays commands read only the first
// 16 bytes). Field j of command i is cmd[5*i + j]; the per-frame reset clears
// every instanceCount field. The sorted array is TYPE-PARTITIONED (MODEL at
// [0, N_model), ALPHA at [N_model, N_total)), so each count is EXACT:
//   IDX_CNT_MODELOP / IDX_CNT_GHOST = N_model (both body segments cover the
//                   same model partition; MODELOP doubles as the ALPHA
//                   partition's start offset for textured.vsh)
//   IDX_CNT_CARRIER = N_carrier (the held-item carrier sweep's exact count)
//   IDX_CNT_ALPHA   = N_alpha (the sprite partition's exact item count)
layout(std430, binding = BIND_INDIRECT) buffer IndirectBuf {
    uint cmd[INDIRECT_UINTS];
} indirect;

layout(std430, binding = BIND_COUNTER) buffer CounterBuf {
    uint writeSlot;          // live-particle compaction cursor (update/emit atomicAdd)
    uint spare;              // end-of-frame capture slot (see capture.comp)
    uint translucentCensus;  // unculled translucent census: ALPHA + MODEL (keygen)
    uint sortItems;          // initial-sort-array append cursor (keygen only)
} counter;

// Per-frame crosshair hit-query result (see hit.comp): x = packed sort key
// (quantized ray distance << 22 | particle index), y = winner's HP bits
// (published by capture.comp), z = storm member identity (HIT_MISS for
// non-storm MODEL particles, published by capture.comp). 0xFFFFFFFF = miss.
layout(std430, binding = BIND_HIT) buffer HitBuf {
    uvec4 pair;
} hitOut;

void main() {
    counter.writeSlot = 0u;
    counter.spare = 0u;
    counter.translucentCensus = 0u;
    counter.sortItems = 0u;
    indirect.cmd[IDX_CNT_ADD] = 0u;
    indirect.cmd[IDX_CNT_SPRITE] = 0u;
    indirect.cmd[IDX_CNT_MODELOP] = 0u;
    indirect.cmd[IDX_CNT_CARRIER] = 0u;
    indirect.cmd[IDX_CNT_GHOST] = 0u;
    indirect.cmd[IDX_CNT_ALPHA] = 0u;
    hitOut.pair = uvec4(0xFFFFFFFFu, 0u, 0xFFFFFFFFu, 0u);
}
