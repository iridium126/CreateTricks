layout(local_size_x = 1) in;

layout(std430, binding = 2) buffer IndirectBuf {
    uvec4 cmd[2]; // [0] additive, [1] alpha — vertexCount, instanceCount, first, baseInstance
} indirect;

layout(std430, binding = 3) buffer CounterBuf {
    uint writeSlot; // live-particle compaction cursor (update/emit atomicAdd)
    uint spare;     // end-of-frame capture slot (see capture.comp)
    uint alphaAlive; // unculled alpha census (keygen, before the frustum test)
} counter;

void main() {
    counter.writeSlot = 0u;
    counter.spare = 0u;
    counter.alphaAlive = 0u;
    indirect.cmd[0].y = 0u;
    indirect.cmd[1].y = 0u;
}
