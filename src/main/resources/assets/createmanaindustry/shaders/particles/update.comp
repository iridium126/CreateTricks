// Particle update: integrates live particles (compaction), preserving the dense
// prefix invariant of the output buffer. Dead particles drop out. Adds:
//   - vanilla cherry-style flutter (life-gated horizontal spiral, header 7.z)
//   - block collision (occupancy 3D texture, axis-separated pre-move sweep,
//     header 7.y) — when the sweep runs it owns the position update entirely.
//     The occupancy slice is chosen PER PARTICLE by scanning bakeMeta for the
//     first baked volume containing the position; the emitter header carries
//     no world-position state, so one spec can serve many spawn sites.
//   - keygen.comp owns the per-material draw counts; this pass never touches
//     the indirect command buffer.
// The live count comes from the GPU itself (the PREVIOUS frame's counter slot
// at binding 14): the CPU only knows a safe upper bound for the dispatch, and
// the extra threads exit on the exact count below.
layout(local_size_x = 64) in;

const int SX = 48;
const int SY = 32;
const int SZ = 48;
const int BAKE_SLICES = 8; // CollisionBake.MAX_SLICES

layout(std430, binding = BIND_POOL_READ) readonly buffer ParticleRead { vec4 data[]; } readBuf;
layout(std430, binding = BIND_POOL_WRITE) buffer ParticleWrite { vec4 data[]; } writeBuf;
layout(std430, binding = BIND_COUNTER) buffer CounterBuf { uint writeSlot; uint spare; uint translucentCensus; } counter;
layout(std430, binding = BIND_EMITTER) readonly buffer EmitterBuf { vec4 u[]; } emitters;
layout(std430, binding = BIND_BAKEMETA) readonly buffer BakeMetaBuf { vec4 m[]; } bakeMeta;
// previous frame's counter slot: its writeSlot is the read buffer's EXACT live
// count (final value after that frame's update+emit appends)
layout(std430, binding = BIND_PREV_COUNTER) readonly buffer PrevCounterBuf { uint live; uint spare; uint translucentCensus; } prevCounter;

layout(binding = 0) uniform sampler3D uCollision;

uniform uint uCapacity;
uniform float uDt;
uniform int  uCollisionOn; // 1 = collision texture/SSBO bound & valid

// ---- storm swarm (boids) -------------------------------------------------
// Spatial hash built by gridbuild.comp earlier THIS frame against the same
// read pool / previous-frame counter slot this pass consumes.
layout(std430, binding = BIND_GRID) buffer GridBuf {
    int heads[GRID_TABLE]; // bucket head: live index + 1 (0 = empty bucket)
    int next[];            // sized by pool capacity on the Java side
} grid;
uniform float uTimeSec;
uniform vec3  uPlayerPos;
uniform int   uPlayerOn;   // 1 = uPlayerPos valid
uniform uint  uKillEmit;   // emitter id force-expired this frame (none = ~0u)
uniform float uStormOmega; // SIGNED angular velocity rad/s (vortex mode; 0 = n/a)

const float CELL_SIZE        = 2.5;  // == neighbour radius (one cell per axis)
const float STORM_SEP_R      = 1.0;
const float STORM_W_COHESION = 1.6;
const float STORM_W_ALIGN    = 1.1;
const float STORM_W_SEP      = 6.0;
const float STORM_W_CONTAIN  = 3.0;
const float STORM_PLAYER_R   = 3.0;
const float STORM_PLAYER_W   = 14.0;

#pragma cmi_include chunks/allay_pose.glsl

bool solidAt(vec3 wp, vec3 mOrigin, int slice) {
    vec3 rel = wp - mOrigin;
    ivec3 tc = ivec3(floor(rel + vec3(0.0001)));
    if (tc.x < 0 || tc.x >= SX || tc.y < 0 || tc.y >= SY || tc.z < 0 || tc.z >= SZ)
        return false;
    tc.z += slice * SZ;
    return texelFetch(uCollision, tc, 0).r > 0.5;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= prevCounter.live)
        return;

    uint base = idx * 4u;
    vec4 p0 = readBuf.data[base + 0u];
    vec4 p1 = readBuf.data[base + 1u];
    vec4 p2 = readBuf.data[base + 2u];
    vec4 p3 = readBuf.data[base + 3u];

    float age = p3.x;
    float maxLife = p3.y;
    if (age >= maxLife)
        return; // dead -> drops out of the compacted output

    uint eid = floatBitsToUint(p3.w);
    if (eid == uKillEmit)
        return; // storm stopped: drop out of the compacted output immediately
    uint hb = eid * VEC4_PER_EMITTER;
    vec3 gravity = emitters.u[hb + 2u].xyz;
    float drag = emitters.u[hb + 2u].w;
    vec3 accel = emitters.u[hb + 3u].xyz;
    float windStrength = emitters.u[hb + 3u].w;
    vec3 windDir = emitters.u[hb + 4u].xyz;

    vec3 pos = p0.xyz;
    vec3 vel = p1.xyz;

    vel += gravity * uDt;
    vel += accel * uDt;
    vel += windDir * (windStrength * uDt);
    vel *= max(0.0, 1.0 - drag * uDt);

    // Vanilla cherry-style spiral flutter: horizontal accel growing as age^1.25.
    // Vanilla does xd += cos(seed*60deg) * A * f^1.25 * 0.0025 per tick (A = 2.0,
    // xd in blocks/tick). Converting to blocks/s: 1 blocks/tick = 20 blocks/s and
    // 1 tick = 0.05 s, so the equivalent continuous acceleration is
    // A * f^1.25 * (0.0025 * 20 * 20) = A * f^1.25 * 1.0 blocks/s^2.
    float flutter = emitters.u[hb + 7u].z;
    if (flutter > 0.0) {
        float fr = clamp(age / max(maxLife, 1e-5), 0.0, 1.0);
        float ang = radians(p3.z * 60.0);
        float acc = flutter * pow(fr, 1.25);
        vel.x += cos(ang) * acc * uDt;
        vel.z += sin(ang) * acc * uDt;
    }

    // ---- storm swarm steering ------------------------------------------------
    // Mode 1 (ball): boids neighbour forces + containment shell around G(t).
    // Mode 2 (vortex): ROTATING-FRAME pseudo-force solution. Each tick the
    // member's state is expressed in the frame spinning at signed uStormOmega
    // about G(t); real forces there are the under-damped home-circle springs
    // (radius + height), separation and player repulsion, while centrifugal
    // (w^2 r) and Coriolis (-2 w x v_frame) fall out of the transform -- their
    // interplay etches the persistent spiral arms. Only WORLD-frame
    // acceleration leaves this block: the collision sweep below still owns
    // the final position move.
    vec4 stormA = emitters.u[hb + 18u]; // x mode(0 none|1 ball|2 vortex), y radius, z wanderRadius, w maxSpeed
    if (stormA.x > 0.5 && stormA.x < 1.5) {
        vec3 anchor = emitters.u[hb + 19u].xyz;
        vec3 G = cmiStormCenter(anchor, stormA.z, p3.z, uTimeSec);
        vec3 acc = vec3(0.0);

        {
            vec3 centerSum = vec3(0.0);
            vec3 velSum = vec3(0.0);
            vec3 sepSum = vec3(0.0);
            int nCount = 0;
            ivec3 pc = ivec3(floor(pos / CELL_SIZE));
            for (int ox = -1; ox <= 1; ox++)
            for (int oy = -1; oy <= 1; oy++)
            for (int oz = -1; oz <= 1; oz++) {
                ivec3 c = pc + ivec3(ox, oy, oz);
                uint hcell = (uint(c.x) * 92837111u ^ uint(c.y) * 689287499u ^ uint(c.z) * 283923481u)
                        & (GRID_TABLE - 1u);
                int s = grid.heads[int(hcell)];
                while (s != 0) {
                    int j = s - 1;
                    s = grid.next[j];
                    if (j == int(idx))
                        continue;
                    uint jb = uint(j) * 4u;
                    vec3 op = readBuf.data[jb].xyz;
                    vec3 d = op - pos;
                    float d2 = dot(d, d);
                    if (d2 < CELL_SIZE * CELL_SIZE && d2 > 1e-8) {
                        centerSum += op;
                        velSum += readBuf.data[jb + 1u].xyz;
                        nCount++;
                        if (d2 < STORM_SEP_R * STORM_SEP_R) {
                            float dl = sqrt(d2);
                            sepSum -= d * ((STORM_SEP_R - dl) / (dl * STORM_SEP_R));
                        }
                    }
                }
            }
            if (nCount > 0) {
                acc += ((centerSum / float(nCount)) - pos) * STORM_W_COHESION;
                acc += (velSum / float(nCount) - vel) * STORM_W_ALIGN;
            }
            acc += sepSum * STORM_W_SEP;
        }

        // soft containment shell around the wandering centre
        vec3 toG = G - pos;
        float dG = length(toG);
        float ballR = max(stormA.y, 1.0);
        if (dG > ballR * 0.75)
            acc += (toG / dG) * STORM_W_CONTAIN * (dG - ballR * 0.75);
        else if (dG < ballR * 0.15 && dG > 1e-3)
            acc -= (toG / dG) * STORM_W_CONTAIN * (ballR * 0.15 - dG);

        // fish avoiding the diver
        if (uPlayerOn == 1) {
            vec3 dp = pos - uPlayerPos;
            float dpL = length(dp);
            if (dpL < STORM_PLAYER_R && dpL > 1e-3)
                acc += (dp / dpL) * STORM_PLAYER_W * (STORM_PLAYER_R - dpL) / STORM_PLAYER_R;
        }

        vel += acc * uDt;
        float spMax = max(stormA.w, 0.5);
        float spd = length(vel);
        if (spd > spMax)
            vel *= spMax / spd;
    }
    else if (stormA.x > 1.5) {
        // ----- vortex: integrate in the co-rotating frame ---------------------
        vec3 anchor = emitters.u[hb + 19u].xyz;
        vec3 G = cmiStormCenter(anchor, stormA.z, p3.z, uTimeSec);
        float omega = uStormOmega;
        float th = omega * uTimeSec;
        float cth = cos(th);
        float sth = sin(th);
        // R_y(-th) into the frame (helper keeps both directions consistent)
        #define CMIST_ROT(v, c, s) vec3((c) * (v).x + (s) * (v).z, (v).y, -(s) * (v).x + (c) * (v).z)

        vec3 rel = pos - G;
        vec3 pF = CMIST_ROT(rel, cth, -sth);
        // frame velocity: rotate world velocity in, subtract the FRAME drag
        // velocity w x pF (rotation-covariant, so the axis-cross uses pF, not
        // the world offset -- mixing the two silently skews every spiral)
        vec3 vF = CMIST_ROT(vel, cth, -sth) - vec3(omega * pF.z, 0.0, -omega * pF.x);

        // per-particle home circle + deck height (stateless from seed)
        float ballR = max(stormA.y, 2.0);
        float homeR = mix(ballR * 0.35, ballR, cmiHash1(p3.z * 5.7));
        float homeY = (cmiHash1(p3.z * 9.1) * 2.0 - 1.0) * 1.2;

        // under-damped springs toward the home circle/deck (frame coords)
        vec2 pr = pF.xz;
        float e = length(pr);
        vec2 dirOut = e > 1e-3 ? pr / e : vec2(1.0, 0.0);
        float vRad = dot(vF.xz, dirOut);
        vec2 aRad = dirOut * (-(2.5) * (e - homeR) - (0.55) * vRad);
        vec3 aF = vec3(aRad, -(2.0) * (pF.y - homeY) - (1.2) * vF.y);

        // pseudo-forces of the rotating frame
        aF.xz += omega * omega * pF.xz;                       // centrifugal
        aF += vec3(-2.0 * omega * vF.z, 0.0, 2.0 * omega * vF.x); // Coriolis

        // separation + player repulsion (rotation-invariant distances; the
        // world-space vectors are rotated back out together with aF below)
        vec3 sepW = vec3(0.0);
        if (idx < prevCounter.live) {
            ivec3 pc = ivec3(floor(pos / CELL_SIZE));
            for (int ox = -1; ox <= 1; ox++)
            for (int oy = -1; oy <= 1; oy++)
            for (int oz = -1; oz <= 1; oz++) {
                ivec3 c3 = pc + ivec3(ox, oy, oz);
                uint hcell = (uint(c3.x) * 92837111u ^ uint(c3.y) * 689287499u ^ uint(c3.z) * 283923481u)
                        & (GRID_TABLE - 1u);
                int sN = grid.heads[int(hcell)];
                while (sN != 0) {
                    int j = sN - 1;
                    sN = grid.next[j];
                    if (j == int(idx))
                        continue;
                    vec3 op = readBuf.data[uint(j) * 4u].xyz;
                    vec3 d = pos - op;
                    float d2 = dot(d, d);
                    if (d2 < STORM_SEP_R * STORM_SEP_R && d2 > 1e-8) {
                        float dl = sqrt(d2);
                        sepW += d * ((STORM_SEP_R - dl) / (dl * STORM_SEP_R));
                    }
                }
            }
            sepW *= STORM_W_SEP;
        }
        vec3 repW = vec3(0.0);
        if (uPlayerOn == 1) {
            vec3 dp = pos - uPlayerPos;
            float dpL = length(dp);
            if (dpL < STORM_PLAYER_R && dpL > 1e-3)
                repW = (dp / dpL) * STORM_PLAYER_W * (STORM_PLAYER_R - dpL) / STORM_PLAYER_R;
        }

        // back to world: rotate the frame-side acceleration out, add the
        // already-world-space terms, hand ONE acceleration to the integrator
        vec3 aW = CMIST_ROT(aF, cth, sth) + sepW + repW;
        vel += aW * uDt;
        float spMaxV = max(stormA.w, 0.5);
        float spdV = length(vel);
        if (spdV > spMaxV)
            vel *= spMaxV / spdV;
    }

    // ---- block collision: axis-separated sweep from the PRE-move position ----
    // Each axis tests one step ahead; a blocked axis zeroes its velocity and
    // keeps the particle in place, a free axis advances exactly vel*uDt. The
    // sweep fully owns the position update when it runs, so the plain Euler
    // integration below is skipped — with and without collision a frame moves
    // exactly vel*uDt (the old code integrated first and then swept from the
    // already-moved position, doubling the speed and tunnelling into blocks).
    bool swept = false;
    bool landed = false;
    float collideMode = emitters.u[hb + 7u].y;
    if (uCollisionOn == 1 && collideMode > 0.5) {
        // Slice selection is position-owned, not emitter-owned: the first baked
        // volume that CONTAINS the particle wins (presence gates unbuilt
        // slices). Two emitters sharing one spec at distant sites can never
        // fight over a header bake index (there is none), and a particle
        // drifting out of its spawn volume keeps colliding inside any other
        // site's volume it enters.
        int slice = -1;
        vec3 mOrigin = vec3(0.0);
        for (int i = 0; i < BAKE_SLICES; i++) {
            vec4 meta = bakeMeta.m[i];
            if (meta.w < 0.5)
                continue;
            vec3 rel = pos - meta.xyz;
            ivec3 tc = ivec3(floor(rel + vec3(0.0001)));
            if (tc.x >= 0 && tc.x < SX && tc.y >= 0 && tc.y < SY && tc.z >= 0 && tc.z < SZ) {
                slice = i;
                mOrigin = meta.xyz;
                break;
            }
        }
        if (slice >= 0) {
            swept = true;
            float sx = vel.x * uDt;
            if (sx != 0.0) {
                if (solidAt(pos + vec3(sx, 0.0, 0.0), mOrigin, slice))
                    vel.x = 0.0;
                else
                    pos.x += sx;
            }
            float sy = vel.y * uDt;
            if (sy != 0.0) {
                if (solidAt(pos + vec3(0.0, sy, 0.0), mOrigin, slice)) {
                    vel.y = 0.0;
                    if (sy < 0.0) {
                        landed = true;
                        // if the blocked step's target voxel is the voxel the
                        // particle already sits in (spawned inside a block),
                        // pop it up onto that voxel's top face
                        float top = floor(pos.y + sy + 0.0001) + 1.0;
                        pos.y = max(pos.y, top);
                    }
                } else {
                    pos.y += sy;
                }
            }
            float sz = vel.z * uDt;
            if (sz != 0.0) {
                if (solidAt(pos + vec3(0.0, 0.0, sz), mOrigin, slice))
                    vel.z = 0.0;
                else
                    pos.z += sz;
            }
        }
    }

    if (!swept)
        pos += vel * uDt;
    age += uDt;

    // DIE_ON_GROUND (cherry): draw the landing frame once, gone next tick.
    if (collideMode > 1.5 && landed)
        age = maxLife;

    uint slot = atomicAdd(counter.writeSlot, 1u);
    if (slot >= uCapacity)
        return;

    uint wb = slot * 4u;
    writeBuf.data[wb + 0u] = vec4(pos, p0.w);
    writeBuf.data[wb + 1u] = vec4(vel, p1.w);
    writeBuf.data[wb + 2u] = p2;
    writeBuf.data[wb + 3u] = vec4(age, p3.y, p3.z, p3.w);
}
