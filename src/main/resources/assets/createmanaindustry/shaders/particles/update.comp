// Particle update: integrates live particles (compaction), preserving the dense
// prefix invariant of the output buffer. Dead particles drop out. Adds:
//   - MODEL (allay) hit points: the maxLife slot carries HP (init 20.0 = the
//     vanilla Allay MAX_HEALTH); CPU melee damage arrives through the damage
//     queue (binding BIND_DAMAGE) and lands inside the owning particle's own
//     thread. HP<=0 converts the particle to a corpse whose countdown
//     (0 -> -1 over the vanilla 20-tick death window) drives the death pose
//     in model.vsh; corpses use vanilla death physics and are not hittable.
//     Alive MODEL particles regen at the vanilla 2 HP/s; p2.w is their
//     hurt-flash timer (0.5 s, vanilla hurtTime).
//   - vanilla cherry-style flutter (life-gated horizontal spiral, header 7.z)
//   - block collision (occupancy 3D texture, axis-separated pre-move sweep,
//     header 7.y) — when the sweep runs it owns the position update entirely.
//     The occupancy slice is chosen PER PARTICLE by scanning bakeMeta for the
//     first baked volume containing the position; the emitter header carries
//     no world-position state, so one spec can serve many spawn sites.
//   - keygen.comp owns the per-material draw counts; this pass never touches
//     the indirect command buffer.
// The live count comes from the GPU itself (the PREVIOUS frame's counter slot
// at binding 14): the CPU only knows a safe upper bound for the dispatch, and
// the extra threads exit on the exact count below.
layout(local_size_x = 64) in;

const int SX = 48;
const int SY = 32;
const int SZ = 48;
const int BAKE_SLICES = 8; // CollisionBake.MAX_SLICES

layout(std430, binding = BIND_POOL_READ) readonly buffer ParticleRead { vec4 data[]; } readBuf;
layout(std430, binding = BIND_POOL_WRITE) buffer ParticleWrite { vec4 data[]; } writeBuf;
layout(std430, binding = BIND_COUNTER) buffer CounterBuf { uint writeSlot; uint spare; uint translucentCensus; } counter;
layout(std430, binding = BIND_EMITTER) readonly buffer EmitterBuf { vec4 u[]; } emitters;
layout(std430, binding = BIND_BAKEMETA) readonly buffer BakeMetaBuf { vec4 m[]; } bakeMeta;
// previous frame's counter slot: its writeSlot is the read buffer's EXACT live
// count (final value after that frame's update+emit appends)
layout(std430, binding = BIND_PREV_COUNTER) readonly buffer PrevCounterBuf { uint live; uint spare; uint translucentCensus; } prevCounter;
// CPU melee-attack queue (single buffer, NO ring -- the GL command stream
// orders this frame's update before the next frame's CPU header rewrite, and
// reset.comp never touches it; the CPU uploads the header every frame it has
// entries plus one zero-count upload the frame after). Each thread scans for
// ITS OWN particle, so entries apply inside the owning particle's integration --
// no cross-thread races, and only MODEL threads scan. Entry word 4 carries the
// packed light (blockLight + 16*skyLight) sampled at the hit position; it is
// stashed into the target's p1.w (unused by the model path) so the GPU death
// chain can spawn its poof burst with the same lighting. Entry word 5 packs
// the key type and the server death verdict:
//   key (word 0) = POOL INDEX when flags bit0 = 0 (legacy local-authority
//     damage, non-storm MODEL debug particles)
//   key           = MEMBER INDEX when flags bit0 = 1 (storm damage: matches
//     p0.w identity, so pool recompaction can never mis-address it)
//   flags bit1    = server-decided DEATH: force the corpse immediately. A
//     client must NEVER decide a storm member's death from its local HP
//     mirror (mid-fight joiners have a full-HP baseline); the bit clamps
//     hp to 0 unconditionally. Entries landing on a corpse are idempotent.
layout(std430, binding = BIND_DAMAGE) readonly buffer DamageBuf {
    uvec4 header;      // x = entry count (y..z unused)
    float entries[];   // stride 6: (key, damage, kbVecX, kbVecZ, lightPacked, flags)
} damageQ;

layout(binding = 0) uniform sampler3D uCollision;

uniform uint uCapacity;
uniform float uDt;
uniform int  uCollisionOn; // 1 = collision texture/SSBO bound & valid

// ---- storm swarm (boids) -------------------------------------------------
// Spatial hash built by gridbuild.comp earlier THIS frame against the same
// read pool / previous-frame counter slot this pass consumes.
layout(std430, binding = BIND_GRID) buffer GridBuf {
    int heads[GRID_TABLE]; // bucket head: live index + 1 (0 = empty bucket)
    int next[];            // sized by pool capacity on the Java side
} grid;
uniform float uTimeSec;
// All-player repulsion source: up to MAX_STORM_PLAYERS synced player
// positions (vanilla entity sync feeds them -- no extra packets). Every
// client repels against the SAME set (each seeing others 1-2 blocks lagged
// by interpolation), so the force field stays near-identical across clients.
layout(std430, binding = BIND_PLAYERS) readonly buffer PlayersBuf { vec4 pl[]; } players;
uniform int   uPlayerCount;
// Network correction slots, indexed by MEMBER identity (p0.w - 1): two vec4
// per member -- {target.xyz, arrivalTime}, {targetVel.xyz, strengthScale}.
// strengthScale 0 = inactive; 1 = regular snapshot correction (age-ramped,
// ~1.5 s window); >2.5 = hit correction (fixed 0.25 s window, strong) written
// when a server DAMAGE broadcast lands so every client eases the struck
// member to the attacker's exact hit spot. Corrections are SOFT: they only
// add spring acceleration and blend velocity -- positions keep moving
// through the integrator, never teleport (see the design doc).
layout(std430, binding = BIND_CORRECTION) readonly buffer CorrectionBuf { vec4 c[]; } correction;
// Storm member identity -> pool-slot map, rebuilt EVERY frame by this pass:
// each member present in the input pool writes map[memberIdx] = its INPUT
// slot + 1 (0 = absent). The input slot is exactly what emit.comp's combat
// styles resolve against in the SAME dispatch (they read the read pool), so
// member-keyed origin tracking survives pool recompaction across frames.
// Sized like the correction slots (2 vec4 there, 1 float here per slot).
layout(std430, binding = BIND_MEMBERMAP) buffer MemberMapBuf { float m[]; } memberMap;
uniform uint  uKillEmit;   // emitter id force-expired this frame (none = ~0u)
uniform float uStormOmega; // SIGNED angular velocity rad/s (vortex mode; 0 = n/a)

const float CELL_SIZE        = 2.5;  // == neighbour radius (one cell per axis)
const float STORM_SEP_R      = 1.0;
const float STORM_W_COHESION = 1.6;
const float STORM_W_ALIGN    = 1.1;
const float STORM_W_SEP      = 6.0;
const float STORM_W_CONTAIN  = 3.0;
const float STORM_PLAYER_R   = 3.0;
const float STORM_PLAYER_W   = 14.0;
// vortex home-point servo (see the vortex branch): stiffness 24 leaves a
// steady-state centripetal tracking lag of omega^2*homeR/24 (~0.13 blocks at
// the default parameters); damping 6 -> zeta ~ 0.61, and the semi-implicit
// integrator stays non-amplifying clear up to the 0.25 s worst-case dt.
const float STORM_VORTEX_K   = 24.0;
const float STORM_VORTEX_C   = 6.0;
// Per-particle cap on grid-chain NODE VISITS across the 27-cell sweep. Chain
// length scales with swarm density (and hash collisions pull far particles in
// too), so an unbounded walk degraded toward O(N^2) at the 131072-member stress
// cap (~25k node hops per particle inside a shrunken bait ball). The budget
// bounds each thread's whole sweep at a worst case of ~34M hops fleet-wide
// (parallel lanes, latency-cheap); under ordinary densities it never engages,
// and above it steering samples an arrival-order (spatially arbitrary) prefix
// of each chain -- a bounded random neighbourhood, acceptable for flocking.
const int   STORM_MAX_VISITS = 256;

#pragma cmi_include chunks/allay_pose.glsl

bool solidAt(vec3 wp, vec3 mOrigin, int slice) {
    vec3 rel = wp - mOrigin;
    ivec3 tc = ivec3(floor(rel + vec3(0.0001)));
    if (tc.x < 0 || tc.x >= SX || tc.y < 0 || tc.y >= SY || tc.z < 0 || tc.z >= SZ)
        return false;
    tc.z += slice * SZ;
    return texelFetch(uCollision, tc, 0).r > 0.5;
}

vec2 cmiGauss2(float s) {
    float u1 = max(cmiHash1(s), 1e-6);
    float u2 = cmiHash1(s + 17.17);
    float r = sqrt(-2.0 * log(u1));
    return vec2(r * cos(6.2831853 * u2), r * sin(6.2831853 * u2));
}

// Death chain: a MODEL particle whose corpse countdown just crossed the end of
// the vanilla 20-tick death window (LivingEntity.tickDeath broadcasting event
// 60) spawns its poof burst HERE -- the corpse position is GPU-only state, so
// the CPU can neither time nor place this. 20 particles with the vanilla
// makePoofParticles distribution: position uniform inside the allay bounding
// box (getRandomX/Z(1.0) = ±bbWidth, getRandomY = 0..bbHeight), velocity =
// gaussian*0.02 + uniform*±0.05 blocks/tick = gaussian*0.4 + uniform*±1.0 b/s.
// The poof emitter's spec (life/drag/gravity/sprites) is read from its own
// header; lighting comes from the light stash the damage queue left in p1.w.
void spawnDeathPoof(uint hb, vec4 p0, vec4 p1, vec4 p3) {
    float chain = emitters.u[hb + 16u].x; // deathEmitId (0 = none)
    if (chain < 0.5)
        return;
    uint cb = uint(chain) * VEC4_PER_EMITTER;
    // storm members carry their IDENTITY in p0.w (memberIdx+1, up to 131073)
    // -- the size multiplier for them is a constant 1.0 (header storm slot
    // 18.x > 0.5), or the poof metrics would scale with the member index
    float pmul = emitters.u[hb + 18u].x > 0.5 ? 1.0 : p0.w;
    float ssize = emitters.u[hb + 5u].w * pmul; // corpse life clamps to 1 → sizeEnd
    float sscale = (2.0 * ssize) / MODEL_ABOVE_FEET;
    float sw = 0.35 * sscale; // vanilla Allay bbWidth × render scale
    float sh = 0.6 * sscale;  // vanilla Allay bbHeight × render scale
    float light = p1.w;       // packed light stashed by the damage queue
    for (int i = 0; i < 20; i++) {
        float s = p3.z * 91.7 + float(i) * 7.31;
        vec2 ga = cmiGauss2(s + 21.0);
        vec2 gb = cmiGauss2(s + 41.0);
        vec3 pos = vec3(p0.x + (cmiHash1(s) * 2.0 - 1.0) * sw,
                        p0.y + cmiHash1(s + 1.0) * sh,
                        p0.z + (cmiHash1(s + 2.0) * 2.0 - 1.0) * sw);
        vec3 vel = vec3(ga.x * 0.4 + (cmiHash1(s + 3.0) * 2.0 - 1.0),
                        ga.y * 0.4 + (cmiHash1(s + 4.0) * 2.0 - 1.0),
                        gb.x * 0.4 + (cmiHash1(s + 5.0) * 2.0 - 1.0));
        float maxLife = max(mix(emitters.u[cb + 5u].x, emitters.u[cb + 5u].y,
                                cmiHash1(s + 12.1)), 0.1);
        uint slot = atomicAdd(counter.writeSlot, 1u);
        if (slot >= uCapacity)
            return;
        uint wb = slot * 4u;
        // p0.w: ExplodeParticle quadSize 0.1*(r²*6+1) → 0.1..0.7 half-extent via
        // the 0.30 spec size × this 0.333..2.333 multiplier
        writeBuf.data[wb + 0u] = vec4(pos, 0.333 + 2.0 * cmiHash1(s + 13.1));
        writeBuf.data[wb + 1u] = vec4(vel, 0.0);
        writeBuf.data[wb + 2u] = vec4(1.0, 1.0, 1.0, light);
        writeBuf.data[wb + 3u] = vec4(0.0, maxLife, s, uintBitsToFloat(uint(chain)));
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= prevCounter.live)
        return;

    uint base = idx * 4u;
    vec4 p0 = readBuf.data[base + 0u];
    vec4 p1 = readBuf.data[base + 1u];
    vec4 p2 = readBuf.data[base + 2u];
    vec4 p3 = readBuf.data[base + 3u];

    uint eid = floatBitsToUint(p3.w);
    if (eid == uKillEmit)
        return; // storm stopped: drop out of the compacted output immediately
    uint hb = eid * VEC4_PER_EMITTER;

    // identity map write (see the buffer declaration). Header-flag gate
    // matches gridbuild/stormpos/hit (the storm spec dedupes to its own
    // emitter id, so every particle of a flagged emitter is a member); the
    // capacity guard mirrors the correction slots. Written BEFORE any early
    // return: even a corpse-expiring thread's entry stays factually correct
    // for this dispatch (the corpse IS in the input pool at this slot).
    if (emitters.u[hb + 18u].x > 0.5) {
        uint mi = uint(p0.w + 0.5) - 1u;
        if (mi < uCapacity)
            memberMap.m[mi] = uintBitsToFloat(idx + 1u);
    }
    float matId = emitters.u[hb + 7u].x;
    bool isModel = matId >= 1.5 && matId < 2.5;

    float age = p3.x;  // animation clock -- NEVER reset, even on death
    float hp = p3.y;   // MODEL: hit points; every other material: max life
    if (isModel) {
        // corpse countdown: hp counts 0 -> -1 across the vanilla 20-tick death
        // window, then the particle drops out of the compacted output. The
        // frame it crosses spawns the vanilla death poof burst first (exactly
        // once: the particle compacts away right after).
        if (hp <= -1.0) {
            spawnDeathPoof(hb, p0, p1, p3);
            return;
        }
    } else if (age >= hp) {
        return; // lifetime expired -> drops out of the compacted output
    }

    vec3 gravity = emitters.u[hb + 2u].xyz;
    float drag = emitters.u[hb + 2u].w;
    vec3 accel = emitters.u[hb + 3u].xyz;
    float windStrength = emitters.u[hb + 3u].w;
    vec3 windDir = emitters.u[hb + 4u].xyz;

    vec3 pos = p0.xyz;
    vec3 vel = p1.xyz;

    // ---- damage queue (MODEL): local + server-relayed attacks land here ----
    float hurt = p2.w; // MODEL: hurt-flash timer; other materials: intensity
    // p1.w (billboard roll, unused by the model path) doubles as the packed
    // light stash once a damage entry lands; the death chain reads it.
    float roll = p1.w;
    if (isModel) {
        // storm gate rides the HEADER storm slot (18.x, same gate as the
        // memberMap write above): p0.w identity is memberIdx+1, which collides
        // with a non-storm MODEL's constant 1.0 size multiplier exactly at
        // member 0 -- a p0.w >= 1.5 test silently drops member 0 from the
        // whole damage pipeline
        bool isStorm = emitters.u[hb + 18u].x > 0.5;
        uint n = min(damageQ.header.x, uint(DAMAGE_QUEUE_CAP));
        for (uint i = 0u; i < n; i++) {
            uint ob = i * 6u;
            float flags = damageQ.entries[ob + 5u];
            bool memberKey = mod(flags, 2.0) >= 0.5; // bit 0: key is member id
            bool died = flags >= 2.5;                // bit 1: server death verdict
            uint key = uint(damageQ.entries[ob + 0u] + 0.5);
            if (memberKey) {
                // storm entry: match by MEMBER identity, immune to pool
                // recompaction; a corpse consumes it idempotently (a second
                // entry must never restart the death countdown)
                if (!isStorm || hp <= 0.0 || key != uint(p0.w + 0.5) - 1u)
                    continue;
            } else {
                if (isStorm || key != idx)
                    continue;
            }
            bool wasAlive = hp > 0.0;
            hp -= damageQ.entries[ob + 1u];
            // vanilla LivingEntity.knockback (airborne target):
            // vel = vel/2 - dir*strength -- the CPU pre-multiplies
            // dir*strength into the entry's zw
            vel.x = vel.x * 0.5 - damageQ.entries[ob + 2u];
            vel.z = vel.z * 0.5 - damageQ.entries[ob + 3u];
            hurt = 1.0;
            roll = damageQ.entries[ob + 4u]; // packed light at the hit
            // the server's died bit is VERDICT, not arithmetic: mid-fight
            // joiners have a full-HP local mirror, so clamp to the corpse
            // state unconditionally (legacy entries keep the old semantics)
            if ((died && memberKey) || (wasAlive && hp <= 0.0))
                hp = 0.0; // kill frame: start the death countdown at zero
        }
    }
    bool corpse = isModel && hp <= 0.0;

    if (!corpse) {
        if (isModel) {
            // vanilla allay regen: heal(1.0) every 10 ticks = 2 HP/s, capped
            // at MAX_HEALTH (Allay.createAttributes); corpses never regen
            hp = min(20.0, hp + 2.0 * uDt);
        }
        vel += gravity * uDt;
        vel += accel * uDt;
        vel += windDir * (windStrength * uDt);
        vel *= max(0.0, 1.0 - drag * uDt);

        // Vanilla cherry-style spiral flutter: horizontal accel growing as age^1.25.
        // Vanilla does xd += cos(seed*60deg) * A * f^1.25 * 0.0025 per tick (A = 2.0,
        // xd in blocks/tick). Converting to blocks/s: 1 blocks/tick = 20 blocks/s and
        // 1 tick = 0.05 s, so the equivalent continuous acceleration is
        // A * f^1.25 * (0.0025 * 20 * 20) = A * f^1.25 * 1.0 blocks/s^2.
        float flutter = emitters.u[hb + 7u].z;
        if (flutter > 0.0) {
            // hp holds maxLife for non-MODEL materials (flutter is sprite-only)
            float fr = clamp(age / max(hp, 1e-5), 0.0, 1.0);
            float ang = radians(p3.z * 60.0);
            float acc = flutter * pow(fr, 1.25);
            vel.x += cos(ang) * acc * uDt;
            vel.z += sin(ang) * acc * uDt;
        }
    } else {
        // vanilla death physics: the Allay OVERRIDES travel (Allay.travel) with
        // NO gravity term anywhere — just move() + a uniform velocity scale of
        // 0.91/tick on ALL axes, continuous drag -ln(0.91)*20 = 1.88621/s.
        // LivingEntity never calls applyGravity (that is projectile/item/TNT
        // territory) and the standard travel gravity path is bypassed by the
        // override, so a corpse does NOT fall: it decays to a stop where it was
        // killed, riding only the kill impulse as it decays.
        vel *= max(0.0, 1.0 - 1.88621 * uDt);
    }

    // ---- storm swarm steering ------------------------------------------------
    // Mode 1 (ball): boids neighbour forces + containment shell around G(t).
    // Mode 2 (vortex): world-frame SERVO onto each member's rotating home
    // point (radius + deck from the seed, phase = omega*t + seed phase).
    // Equilibrium == the analytic spawn state in emit.comp (on the home
    // circle at phase a, velocity omega x r), so late joiners start settled
    // and the pattern phase is a pure function of the shared clock --
    // identical on every client. The engine clamps |omega| to
    // MAX_SPEED / radius client-side, so servo targets always stay reachable
    // by the speed-capped members. Only WORLD-frame acceleration leaves this
    // block: the collision sweep below still owns the final position move.
    vec4 stormA = emitters.u[hb + 18u]; // x mode(0 none|1 ball|2 vortex), y radius, z wanderRadius, w maxSpeed
    if (!corpse && stormA.x > 0.5 && stormA.x < 1.5) {
        vec3 anchor = emitters.u[hb + 19u].xyz;
        vec3 G = cmiStormCenter(anchor, stormA.z, p3.z, uTimeSec);
        vec3 acc = vec3(0.0);

        {
            vec3 centerSum = vec3(0.0);
            vec3 velSum = vec3(0.0);
            vec3 sepSum = vec3(0.0);
            int nCount = 0;
            int visits = 0;
            bool budgetGone = false;
            ivec3 pc = ivec3(floor(pos / CELL_SIZE));
            for (int ox = -1; ox <= 1 && !budgetGone; ox++)
            for (int oy = -1; oy <= 1 && !budgetGone; oy++)
            for (int oz = -1; oz <= 1 && !budgetGone; oz++) {
                ivec3 c = pc + ivec3(ox, oy, oz);
                uint hcell = (uint(c.x) * 92837111u ^ uint(c.y) * 689287499u ^ uint(c.z) * 283923481u)
                        & (GRID_TABLE - 1u);
                int s = grid.heads[int(hcell)];
                while (s != 0) {
                    int j = s - 1;
                    s = grid.next[j];
                    if (++visits > STORM_MAX_VISITS) {
                        budgetGone = true;
                        break;
                    }
                    if (j == int(idx))
                        continue;
                    uint jb = uint(j) * 4u;
                    vec3 op = readBuf.data[jb].xyz;
                    vec3 d = op - pos;
                    float d2 = dot(d, d);
                    if (d2 < CELL_SIZE * CELL_SIZE && d2 > 1e-8) {
                        centerSum += op;
                        velSum += readBuf.data[jb + 1u].xyz;
                        nCount++;
                        if (d2 < STORM_SEP_R * STORM_SEP_R) {
                            float dl = sqrt(d2);
                            sepSum -= d * ((STORM_SEP_R - dl) / (dl * STORM_SEP_R));
                        }
                    }
                }
            }
            if (nCount > 0) {
                acc += ((centerSum / float(nCount)) - pos) * STORM_W_COHESION;
                acc += (velSum / float(nCount) - vel) * STORM_W_ALIGN;
            }
            acc += sepSum * STORM_W_SEP;
        }

        // soft containment shell around the wandering centre
        vec3 toG = G - pos;
        float dG = length(toG);
        float ballR = max(stormA.y, 1.0);
        if (dG > ballR * 0.75)
            acc += (toG / dG) * STORM_W_CONTAIN * (dG - ballR * 0.75);
        else if (dG < ballR * 0.15 && dG > 1e-3)
            acc -= (toG / dG) * STORM_W_CONTAIN * (ballR * 0.15 - dG);

        // fish avoiding EVERY diver (all synced players — same force set on
        // every client; see the PlayersBuf note above)
        for (int pi = 0; pi < uPlayerCount; pi++) {
            vec3 dp = pos - players.pl[pi].xyz;
            float dpL = length(dp);
            if (dpL < STORM_PLAYER_R && dpL > 1e-3)
                acc += (dp / dpL) * STORM_PLAYER_W * (STORM_PLAYER_R - dpL) / STORM_PLAYER_R;
        }

        vel += acc * uDt;
        float spMax = max(stormA.w, 0.5);
        float spd = length(vel);
        if (spd > spMax)
            vel *= spMax / spd;
    }
    else if (!corpse && stormA.x > 1.5) {
        // ----- vortex: world-frame servo to the ROTATING home point ----------
        vec3 anchor = emitters.u[hb + 19u].xyz;
        vec3 G = cmiStormCenter(anchor, stormA.z, p3.z, uTimeSec);
        float omega = uStormOmega;
        float ballR = max(stormA.y, 2.0);
        // per-particle home circle + deck + phase (stateless from seed);
        // the phase hash MUST mirror emit.comp's analytic spawn exactly --
        // the spawn state IS this servo's equilibrium
        float homeR = mix(ballR * 0.35, ballR, cmiHash1(p3.z * 5.7));
        float homeY = (cmiHash1(p3.z * 9.1) * 2.0 - 1.0) * 1.2;
        float a = omega * uTimeSec + cmiHash1(p3.z * 11.3) * 6.2831853;
        float ca = cos(a);
        float sa = sin(a);
        vec3 target = G + vec3(ca * homeR, homeY, sa * homeR);
        // target velocity = orbital term of d(target)/dt; the wander center's
        // own ~0.4 b/s drift is left untracked (absorbed as sub-block lag)
        vec3 vT = vec3(-sa, 0.0, ca) * (omega * homeR);

        // separation + player repulsion, world space exactly like ball mode.
        // Same visit budget as the ball-mode sweep.
        vec3 sepW = vec3(0.0);
        int sepVisits = 0;
        bool sepBudgetGone = false;
        ivec3 pc = ivec3(floor(pos / CELL_SIZE));
        for (int ox = -1; ox <= 1 && !sepBudgetGone; ox++)
        for (int oy = -1; oy <= 1 && !sepBudgetGone; oy++)
        for (int oz = -1; oz <= 1 && !sepBudgetGone; oz++) {
            ivec3 c3 = pc + ivec3(ox, oy, oz);
            uint hcell = (uint(c3.x) * 92837111u ^ uint(c3.y) * 689287499u ^ uint(c3.z) * 283923481u)
                    & (GRID_TABLE - 1u);
            int sN = grid.heads[int(hcell)];
            while (sN != 0) {
                int j = sN - 1;
                sN = grid.next[j];
                if (++sepVisits > STORM_MAX_VISITS) {
                    sepBudgetGone = true;
                    break;
                }
                if (j == int(idx))
                    continue;
                vec3 op = readBuf.data[uint(j) * 4u].xyz;
                vec3 d = pos - op;
                float d2 = dot(d, d);
                if (d2 < STORM_SEP_R * STORM_SEP_R && d2 > 1e-8) {
                    float dl = sqrt(d2);
                    sepW += d * ((STORM_SEP_R - dl) / (dl * STORM_SEP_R));
                }
            }
        }
        sepW *= STORM_W_SEP;
        vec3 repW = vec3(0.0);
        // every synced player repels (all-client-consistent force set)
        for (int pi = 0; pi < uPlayerCount; pi++) {
            vec3 dp = pos - players.pl[pi].xyz;
            float dpL = length(dp);
            if (dpL < STORM_PLAYER_R && dpL > 1e-3)
                repW += (dp / dpL) * STORM_PLAYER_W * (STORM_PLAYER_R - dpL) / STORM_PLAYER_R;
        }

        // servo onto the co-rotating home point, plus the world-space terms,
        // hand ONE acceleration to the integrator (same contract as ball mode)
        vec3 aW = (target - pos) * STORM_VORTEX_K + (vT - vel) * STORM_VORTEX_C + sepW + repW;
        vel += aW * uDt;
        float spMaxV = max(stormA.w, 0.5);
        float spdV = length(vel);
        if (spdV > spMaxV)
            vel *= spMaxV / spdV;
    }

    // ---- network correction (storm members, server-synced positions) -------
    // SOFT convergence only: an acceleration toward the extrapolated target
    // plus a velocity blend. Positions always travel through the integrator
    // (velocity × time, speed-capped by the storm clamp above), so a stale or
    // multi-block correction reads as "flying back into formation", never a
    // teleport. Regular snapshots ramp their strength with slot age -- early
    // window lets local physics speak, late window converges before the next
    // snapshot lands; hit corrections (server DAMAGE broadcasts) run a fixed
    // short window at high strength so the corpse/poof plays at the exact
    // spot the attacker struck.
    // HEADER storm slot gate (see the damage-queue isStorm note): member 0's
    // p0.w (1.0) is indistinguishable from a non-storm MODEL multiplier
    if (!corpse && emitters.u[hb + 18u].x > 0.5) {
        uint memberIdx = uint(p0.w + 0.5) - 1u;
        // correction slots are sized by the POOL capacity (2 vec4 per member);
        // an identity beyond it can never have a slot, so skip instead of
        // addressing outside the buffer
        if (memberIdx < uCapacity) {
            uint ci = memberIdx * 2u;
            vec4 cA = correction.c[ci];
            vec4 cB = correction.c[ci + 1u];
            float cage = uTimeSec - cA.w;
            if (cB.w > 0.5 && cage >= 0.0) {
                bool hitC = cB.w > 2.5;
                float window = hitC ? 0.25 : 1.5;
                if (cage <= window) {
                    vec3 target = cA.xyz + cB.xyz * cage; // velocity extrapolation
                    float ramp = hitC ? 1.0 : (0.25 + 0.75 * clamp(cage / window, 0.0, 1.0));
                    float k = (hitC ? 24.0 : 8.0) * ramp;
                    vel += (target - pos) * min(k * uDt, 0.5);
                    vel += (cB.xyz - vel) * min(2.5 * uDt, 0.35);
                }
            }
        }
    }

    // ---- block collision: axis-separated sweep from the PRE-move position ----
    // Each axis tests one step ahead; a blocked axis zeroes its velocity and
    // keeps the particle in place, a free axis advances exactly vel*uDt. The
    // sweep fully owns the position update when it runs, so the plain Euler
    // integration below is skipped — with and without collision a frame moves
    // exactly vel*uDt (the old code integrated first and then swept from the
    // already-moved position, doubling the speed and tunnelling into blocks).
    bool swept = false;
    bool landed = false;
    float collideMode = emitters.u[hb + 7u].y;
    if (uCollisionOn == 1 && collideMode > 0.5) {
        // Slice selection is position-owned, not emitter-owned: the first baked
        // volume that CONTAINS the particle wins (presence gates unbuilt
        // slices). Two emitters sharing one spec at distant sites can never
        // fight over a header bake index (there is none), and a particle
        // drifting out of its spawn volume keeps colliding inside any other
        // site's volume it enters.
        int slice = -1;
        vec3 mOrigin = vec3(0.0);
        for (int i = 0; i < BAKE_SLICES; i++) {
            vec4 meta = bakeMeta.m[i];
            if (meta.w < 0.5)
                continue;
            vec3 rel = pos - meta.xyz;
            ivec3 tc = ivec3(floor(rel + vec3(0.0001)));
            if (tc.x >= 0 && tc.x < SX && tc.y >= 0 && tc.y < SY && tc.z >= 0 && tc.z < SZ) {
                slice = i;
                mOrigin = meta.xyz;
                break;
            }
        }
        if (slice >= 0) {
            swept = true;
            // Each probe resolves one texel, so a single test move larger than
            // ~1 block tunnels straight through a thin wall AND strands the
            // particle inside it (every neighbour then reads solid). Split the
            // frame move into <= half-voxel substeps: storm members capped at
            // STORM_MAX_SPEED over the clamped 0.25 s worst-case frame travel
            // up to 1.5 blocks. Ordinary speeds keep steps at exactly 1.
            float span = max(abs(vel.x), max(abs(vel.y), abs(vel.z))) * uDt;
            int steps = 1 + int(clamp(span / 0.5, 0.0, 15.0));
            float sdt = uDt / float(steps);
            for (int si = 0; si < steps; si++) {
                float sx = vel.x * sdt;
                if (sx != 0.0) {
                    if (solidAt(pos + vec3(sx, 0.0, 0.0), mOrigin, slice))
                        vel.x = 0.0;
                    else
                        pos.x += sx;
                }
                float sy = vel.y * sdt;
                if (sy != 0.0) {
                    if (solidAt(pos + vec3(0.0, sy, 0.0), mOrigin, slice)) {
                        vel.y = 0.0;
                        if (sy < 0.0) {
                            landed = true;
                            // if the blocked step's target voxel is the voxel
                            // the particle already sits in (spawned inside a
                            // block), pop it up onto that voxel's top face
                            float top = floor(pos.y + sy + 0.0001) + 1.0;
                            pos.y = max(pos.y, top);
                        }
                    } else {
                        pos.y += sy;
                    }
                }
                float sz = vel.z * sdt;
                if (sz != 0.0) {
                    if (solidAt(pos + vec3(0.0, 0.0, sz), mOrigin, slice))
                        vel.z = 0.0;
                    else
                        pos.z += sz;
                }
                if (landed && collideMode > 1.5)
                    break; // dying leaf: no need to keep sweeping this frame
            }
        }
    }

    if (!swept)
        pos += vel * uDt;
    age += uDt;

    // DIE_ON_GROUND (cherry): draw the landing frame once, gone next tick.
    // hp holds maxLife for non-MODEL materials; MODEL never uses DIE_ON_GROUND
    // (corpses expire through the countdown instead).
    if (!isModel && collideMode > 1.5 && landed)
        age = hp;
    // corpse countdown advances AFTER the age bookkeeping; the hurt overlay
    // decays over vanilla's hurtTime (10 ticks = 0.5 s)
    if (isModel) {
        if (corpse)
            hp -= uDt;
        hurt = max(0.0, hurt - 2.0 * uDt);
    }

    uint slot = atomicAdd(counter.writeSlot, 1u);
    if (slot >= uCapacity)
        return;

    uint wb = slot * 4u;
    writeBuf.data[wb + 0u] = vec4(pos, p0.w);
    writeBuf.data[wb + 1u] = vec4(vel, roll);
    writeBuf.data[wb + 2u] = vec4(p2.rgb, hurt);
    writeBuf.data[wb + 3u] = vec4(age, hp, p3.z, p3.w);
}
